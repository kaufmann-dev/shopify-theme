[
  {
    "name": "theme_info",
    "theme_name": "Collection Standard",
    "theme_author": "David Kaufmann",
    "theme_version": "1.0.0",
    "theme_documentation_url": "https://github.com/kaufmann-dev/shopify-theme",
    "theme_support_email": "david@kaufmann.dev"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 180
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_paper",
        "label": "Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Text and primary actions",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#595959"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Focus indicator",
        "default": "#005fcc"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1800,
        "step": 40,
        "unit": "px",
        "label": "Maximum page width",
        "default": 1400
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_sale_badge",
        "label": "Show sale badge",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_sold_out_badge",
        "label": "Show sold out badge",
        "default": true
      }
    ]
  }
]

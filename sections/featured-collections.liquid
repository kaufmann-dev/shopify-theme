<section class="section-space">
  <div class="page-width">
    <div class="section-heading">
      <div class="section-heading__copy">
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
      <a class="text-link" href="{{ routes.collections_url }}">{{ section.settings.link_label | escape }}</a>
    </div>

    <div class="collection-grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.collection != blank -%}
          {% render 'collection-card', collection: block.settings.collection, block: block %}
        {%- else -%}
          <article class="collection-card" {{ block.shopify_attributes }}>
            <div class="collection-card__media">
              {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'collection-card__placeholder' }}
            </div>
            <div class="collection-card__title">
              <span>{{ 'sections.featured_collections.placeholder' | t }}</span>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collections",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Start with the collection that fits your day.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all collections"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}

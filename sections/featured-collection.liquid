<section class="section-space">
  <div class="page-width">
    <div class="section-heading">
      <div class="section-heading__copy">
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.collection != blank -%}
        <a class="text-link" href="{{ section.settings.collection.url }}">{{ 'sections.featured_collection.view_all' | t }}</a>
      {%- endif -%}
    </div>

    <div class="product-grid">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <p>{{ 'sections.featured_collection.empty' | t }}</p>
        {%- endfor -%}
      {%- else -%}
        {%- for index in (1..4) -%}
          <article class="product-card">
            <div class="product-card__media">
              {{ 'product-' | append: index | placeholder_svg_tag: 'product-card__placeholder' }}
            </div>
            <div class="product-card__info">
              <span class="product-card__title">{{ 'sections.featured_collection.placeholder' | t }}</span>
              <span class="product-card__price">{{ 5000 | money }}</span>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest pieces"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "label": "Products to show",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}

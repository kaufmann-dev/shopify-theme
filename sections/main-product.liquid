{%- assign product_form_id = 'ProductForm-' | append: section.id -%}
{%- assign selected_variant = product.selected_or_first_available_variant -%}

<section class="section-space">
  <div class="product page-width">
    <div class="product__media-list">
      {%- for media in product.media -%}
        <div class="product__media">
          {{ media.preview_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '500, 750, 1000, 1300, 1600', sizes: '(min-width: 901px) 60vw, 100vw', alt: media.alt | default: product.title }}
        </div>
      {%- else -%}
        <div class="product__media">
          {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
        </div>
      {%- endfor -%}
    </div>

    <div class="product__details">
      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <div class="product__vendor">{{ product.vendor | escape }}</div>
      {%- endif -%}
      <h1 class="product__title">{{ product.title | escape }}</h1>
      <div id="ProductPrice-{{ section.id }}" class="product__price">
        {{ selected_variant.price | money }}
      </div>

      {%- form 'product', product, id: product_form_id, class: 'product-form' -%}
        <input type="hidden" name="id" value="{{ selected_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          <variant-selector data-form="{{ product_form_id }}" data-price="ProductPrice-{{ section.id }}">
            {%- for option in product.options_with_values -%}
              <div class="field">
                <label for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name | escape }}</label>
                <select id="Option-{{ section.id }}-{{ forloop.index0 }}">
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value | escape }}</option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
            <script type="application/json">
              [
                {%- for variant in product.variants -%}
                  {
                    "id": {{ variant.id | json }},
                    "available": {{ variant.available | json }},
                    "options": {{ variant.options | json }},
                    "formatted_price": {{ variant.price | money | json }}
                  }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              ]
            </script>
          </variant-selector>
        {%- endunless -%}

        <div class="field">
          <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label>
          <input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" inputmode="numeric">
        </div>

        <button
          class="button button--full"
          type="submit"
          name="add"
          data-available="{{ 'products.product.add_to_cart' | t }}"
          data-sold-out="{{ 'products.product.sold_out' | t }}"
          data-unavailable="{{ 'products.product.unavailable' | t }}"
          {% unless selected_variant.available %}disabled{% endunless %}
        >
          {%- if selected_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </button>
        {{ form | payment_button }}
      {%- endform -%}

      {%- if product.description != blank -%}
        <div class="product__description rte">{{ product.description }}</div>
      {%- endif -%}

      <div class="product__meta">
        {%- for block in section.blocks -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.heading | escape }}</summary>
            <div class="product__meta-content rte">{{ block.settings.content }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product information",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "details",
      "name": "Expandable details",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Materials and care"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add care instructions and material details here.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
